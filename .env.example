# Скопируйте в .env для локального запуска. На Railway те же значения вносятся в Variables.
# Ссылка на опубликованную Google Таблицу (формат CSV). Пусто = запасной каталог из data/products.json
SHEET_CSV_URL=
# Курс: сколько AED в 1 USD
USD_RATE=3.65
# WhatsApp: код страны + номер, без + и пробелов
WHATSAPP=971500000000
# Ники без @
TELEGRAM=voyagestore
INSTAGRAM=voyagestore
# Как часто (сек) перечитывать таблицу
CACHE_SECONDS=60
